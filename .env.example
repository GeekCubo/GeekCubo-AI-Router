# GeekCubo SERVER configuration template. Copy to .env (./install.sh does this once).
# Every setting is optional. Uncomment a line to change it; never commit .env.
#
# This file configures the GeekCubo server only. It never holds the key a
# client uses to call GeekCubo: those sk-geek-... keys are generated in
# Settings -> API Keys and belong in the client's own environment (the
# GEEKCUBO_API_KEY variable in Connect a tool configs, or OPENAI_API_KEY plus
# OPENAI_BASE_URL in a generic OpenAI SDK's shell). Do not add them here.

# ── Server ──
# Bind address and port inside the container. docker-compose.yml already sets
# these and publishes the dashboard on 127.0.0.1:8787; change ports: there.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Set true only behind a TLS reverse proxy you control (marks session cookies Secure).
# TRUST_PROXY_HEADERS=false
# The address clients use to reach this installation (root domain or
# subdomain, e.g. https://api.example.com), without /v1. Settings -> API Keys
# shows it as the API endpoint (with /v1), Connect a tool pre-fills it, and
# ./install.sh displays it. Never derived from request headers. Not a bind
# address. Empty = only the local loopback endpoint is shown.
# PUBLIC_BASE_URL=https://example.com

# ── Database ──
# Docker Compose stores SQLite on the geekcubo-data volume (/data/geekcubo.db).
# Outside Docker the default is ./geekcubo.db. Postgres needs the "postgres" extra.
# DATABASE_URL=postgresql+asyncpg://geekcubo:CHANGE_ME@localhost:5432/geekcubo

# ── Encryption secrets (generated automatically) ──
# On first start these are generated and saved next to the SQLite database in
# .geekcubo-secrets (mode 0600). Set them here only to supply your own values or
# when using Postgres. Never change them on an existing install: back them up
# with the data volume and restore both together.
# CREDENTIAL_ENCRYPTION_KEY=
# API_KEY_PEPPER=
# Seals the encrypted copy that lets you copy an sk-geek-* key again later.
# API_KEY_RECOVERY_KEY=
# Old key, set only during a controlled key rotation (see README).
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEY=
# Development only: allow the public fallback key. Never enable in production.
# ALLOW_INSECURE_DEV_KEY=false

# ── Upstream provider keys (optional; or add them in the dashboard) ──
# Dashboard-stored keys take precedence. These are YOUR accounts at each
# provider, used by the GeekCubo server to call them. OPENAI_API_KEY here is an
# OpenAI key (sk-...), not a GeekCubo key (sk-geek-...).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# xAI (Grok), not the same company as Groq.
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# ── Custom providers ──
# Local/private hosts (host or host:port, comma-separated) that custom providers
# may reach over http. Every other custom provider must be public https.
# CUSTOM_PROVIDER_ALLOWED_LOCAL_HOSTS=localhost:8080,127.0.0.1:9000

# ── Quality scores (Artificial Analysis) ──
# Optional; the key can also be saved on the Quality page (encrypted at rest).
# Any Artificial Analysis key (Free, Pro or Commercial) works with the default
# Free language-models endpoint. Set ARTIFICIAL_ANALYSIS_USE_PRO=true to use the
# Pro list; a key without Pro falls back to the Free endpoint automatically.
# ARTIFICIAL_ANALYSIS_API_KEY=
# ARTIFICIAL_ANALYSIS_USE_PRO=false
# Advanced: API base, or a full models-list URL for a mirror. A URL on the
# retired /api/v2/data/ path is ignored.
# ARTIFICIAL_ANALYSIS_API_BASE=https://artificialanalysis.ai/api/v2
# ARTIFICIAL_ANALYSIS_MODELS_URL=

# ── Router tuning ──
# Seconds a failing deployment stays cooled down (0 disables cooldown).
# ROUTER_COOLDOWN_SECONDS=60
# ROUTER_ALLOWED_FAILS=0
# Skip deployments whose context window cannot fit the request.
# ROUTER_PRE_CALL_CHECKS=true
# Retries on the same model: pinned requests / model="auto" (auto moves to the next candidate).
# ROUTER_NUM_RETRIES_DEFAULT=2
# ROUTER_NUM_RETRIES_AUTO=0

# ── Redis (optional) ──
# Moves the prompt cache to Redis and broadcasts config-cache invalidation.
# GeekCubo still runs as a single process; multiple workers are not supported.
# REDIS_URL=redis://localhost:6379/0

# ── Chat attachments ──
# Default directory: attachments/ next to the SQLite file (/data/attachments in Docker).
# ATTACHMENTS_ENABLED=true
# ATTACHMENT_MAX_MB=25
# ATTACHMENT_DIR=/data/attachments

# ── Chat web search ──
# Configure search in Settings → Chat → Web search. This secret is used only by
# the bundled SearXNG container (Compose profile "search"); ./install.sh generates it.
# SEARXNG_SECRET=

# ── Ask GeekCubo (documentation answers in Chat) ──
# Bundled, local documentation index; no service or key needed. false hides the mode.
# KNOWLEDGE_ENABLED=true

# ── Local AI Connect ──
# LOCAL_CONNECT_ENABLED=true
# Public URL written into the generated connector install command and service
# files: your own HTTPS origin. Not derived automatically: when empty they show
# a placeholder host.
# LOCAL_CONNECT_PUBLIC_URL=https://example.com
# How often (seconds) a connected machine reports in; refreshes its last-seen time.
# LOCAL_CONNECT_HEARTBEAT_SECONDS=45
# Minutes an enrollment code stays valid.
# LOCAL_CONNECT_ENROLLMENT_TTL_MINUTES=30
